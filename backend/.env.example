# RailETA Backend Environment Configuration
# Production uses persistent cloud PostgreSQL (Render PostgreSQL / Neon / Supabase)
# Local development falls back to SQLite (sqlite:///./raileta_v3.db) when DATABASE_URL is unset
DATABASE_URL=postgresql://postgres:password@localhost:5432/raileta_db

# Comma-separated CORS origins for Vercel frontend deployment
CORS_ORIGINS=http://localhost:5173,https://raileta.vercel.app,https://raileta-six.vercel.app

# Path to serialized joblib ML model bundle
MODEL_PATH=app/ml/artifacts/raileta_hgb_model.joblib

# Enable background real-time train telemetry simulator (true/false)
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=4

# Do NOT automatically seed synthetic railway data on startup (false by default)
SEED_DEMO_DATA=false

# Default Demo Account Credentials (seeded idempotently into PostgreSQL `users` table)
DEMO_USERNAME=demo
DEMO_PASSWORD=RailETA-Demo-2026

# JWT Signing Key (override with a strong secret in Render production environment)
JWT_SECRET_KEY=replace-with-strong-production-jwt-secret

# Optional External Railway / GPS Telemetry Provider
# Requires an authorized external railway data provider. Leave empty for Prototype Data.
RAILWAY_API_URL=
RAILWAY_API_KEY=
